{
  "name": "vscode-snapshot",
  "displayName": "%extension.displayName%",
  "version": "0.1.1",
  "description": "%extension.description%",
  "publisher": "vczhan",
  "icon": "resources/icon.png",
  "categories": [
    "Other"
  ],
  "galleryBanner": {
    "color": "#fff9d9",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.115.0"
  },
  "homepage": "https://github.com/vczhan/vscode-snapshot",
  "repository": {
    "type": "git",
    "url": "https://github.com/vczhan/vscode-snapshot"
  },
  "activationEvents": [
    "workspaceContains:*"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "snapshot",
          "name": "%views.snapshot.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "snapshot.save",
        "title": "%commands.save.title%",
        "icon": {
          "light": "./resources/light/save.svg",
          "dark": "./resources/dark/save.svg"
        }
      },
      {
        "command": "snapshot.deleteItem",
        "title": "%commands.deleteItem.title%",
        "icon": {
          "light": "./resources/light/remove.svg",
          "dark": "./resources/dark/remove.svg"
        }
      },
      {
        "command": "snapshot.syncFile",
        "title": "%commands.syncFile.title%"
      },
      {
        "command": "snapshot.sync",
        "title": "%commands.sync.title%",
        "icon": {
          "light": "./resources/light/sync.svg",
          "dark": "./resources/dark/sync.svg"
        }
      },
      {
        "command": "snapshot.deleteFile",
        "title": "%commands.deleteFile.title%"
      },
      {
        "command": "snapshot.delete",
        "title": "%commands.delete.title%",
        "icon": {
          "light": "./resources/light/delete.svg",
          "dark": "./resources/dark/delete.svg"
        }
      },
      {
        "command": "snapshot.clearAll",
        "title": "%commands.clearAll.title%"
      },
      {
        "command": "snapshot.clear",
        "title": "%commands.clear.title%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "snapshot.deleteItem",
          "when": "false"
        },
        {
          "command": "snapshot.clear",
          "when": "false"
        },
        {
          "command": "snapshot.sync",
          "when": "false"
        },
        {
          "command": "snapshot.delete",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "snapshot.save",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "snapshot.save",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "snapshot.deleteItem",
          "group": "inline",
          "when": "view == snapshot && viewItem != None"
        }
      ],
      "view/title": [
        {
          "command": "snapshot.sync",
          "group": "navigation@1",
          "when": "view == snapshot"
        },
        {
          "command": "snapshot.delete",
          "group": "navigation@2",
          "when": "view == snapshot"
        },
        {
          "command": "snapshot.clear",
          "when": "view == snapshot"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "%configuration.title%",
      "properties": {
        "snapshot.path": {
          "type": "string",
          "default": ".snapshot",
          "description": "%configuration.path.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint src --ext .ts",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "1.115.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^10.3.0",
    "typescript": "^6.0.3"
  }
}
